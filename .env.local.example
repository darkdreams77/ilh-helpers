# Copy this file to `.env` (or `.env.local`) and fill in the values.
# Never commit real secrets.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ilh_helpers"
# Connexion directe (sans pooler) utilisée par `prisma migrate deploy`.
# Facultative : à défaut, DATABASE_URL sans « -pooler » dans l’hôte est utilisée.
DATABASE_URL_UNPOOLED=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
